# Modo de facturación electrónica del FRONTEND.
#
# Tiene que coincidir con FACTILIZA_MODO en functions/.env. Su único efecto aquí es de qué
# contador de LastCode salen los correlativos: en «pruebas» van a LastCode/PRUEBA-F001, de
# modo que los ensayos no queman numeración real.
#
# Si los dos valores se desincronizan, el backend lo detecta al enviar y se niega a
# declarar el documento (ver `nacidoEnPruebas` en functions/index.js), así que el peor caso
# es un error claro, no un comprobante mal numerado ante SUNAT.
#
# Poner "produccion" SOLO cuando Factiliza haya dado de alta el RUC 20601720621, entregado
# el token de facturación y confirmado las series autorizadas.
VITE_FACTILIZA_MODO=pruebas
