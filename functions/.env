# Variables de entorno de las Cloud Functions del admin.
# El CLI de Firebase despliega este archivo junto con el código.
#
# Sustituye a functions.config(), que dejó de admitir escrituras: el comando
# `firebase functions:config:set` ya falla, y el servicio se apaga en marzo de 2027.
#
# NO poner secretos aquí (este archivo va al repositorio). Para el token usa
# Secret Manager:  firebase functions:secrets:set FACTILIZA_INVOICE_TOKEN

# Entorno de facturación electrónica: "pruebas" (apife-qa) | "produccion" (apife).
#
# Se queda en "pruebas" hasta que Factiliza dé de alta el RUC 20601720621 y entregue un
# token de facturación propio de GM Parts. Verificado el 2026-08-16: contra producción,
# el token actual devuelve 401, y ese RUC no está configurado ni en el entorno de pruebas.
FACTILIZA_MODO=pruebas
